# MongoDB connection URI (local hoặc MongoDB Atlas, ví dụ: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/connectify_db)
MONGO_URI=mongodb://localhost:27017/connectify_db

# JWT Secret Key for Flask-JWT-Extended (bắt buộc, tự đặt một chuỗi dài ngẫu nhiên)
JWT_SECRET_KEY=change_this_to_a_strong_secret_key

# Flask session secret (bắt buộc)
SECRET_KEY=change_this_to_a_secure_flask_secret

# File upload settings
UPLOAD_FOLDER=static/uploads
ALLOW_ABSOLUTE_PATHS=False
